# Server Configuration
API_KEY=diplomarbeit-secret-key

# Database
DATABASE_URL=postgres://wb_user:wb_password@localhost:5433/wb_newsfeed

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# LocalAI (Image Generation)
LOCALAI_URL=http://localhost:8080

# API URL for Frontend Clients
API_URL=http://localhost:3005

# Allowed frontend origins (comma-separated) for CORS.
# Required for navigator.sendBeacon analytics: browsers reject
# wildcard '*' origin when the request's credentials mode is 'include'.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
