# API
API_KEY=diplomarbeit-secret-key
API_URL=http://localhost:3005

# Datenbank und Queue
DATABASE_URL=postgres://wb_user:wb_password@localhost:5433/wb_newsfeed
REDIS_URL=redis://localhost:6379

# Textmodell (Ollama) und Bildserver (FLUX.1-schnell, services/image)
OLLAMA_URL=http://localhost:11434
IMAGE_SERVER_URL=http://localhost:8080

# Optional: Bilder ueber Google Gemini (Nano Banana Pro), im Admin unter Einstellungen waehlbar.
# Key unter https://aistudio.google.com/apikey anlegen. Jedes Bild kostet Guthaben.
GEMINI_API_KEY=

# Erlaubte Origins fuer CORS, durch Komma getrennt.
# Kein '*', weil sendBeacon im Feed mit credentials arbeitet.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:3099
