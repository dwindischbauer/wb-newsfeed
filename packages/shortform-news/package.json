{
  "name": "@wb-news/shortform-news",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "KI-gestützter Short-Form-News-Feed als wiederverwendbare Vue/Nuxt-Komponente.",
  "license": "UNLICENSED",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs"
    },
    "./nuxt": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --watch",
    "prepack": "unbuild",
    "postinstall": "unbuild",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "vue": "^3.4.21"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^4.5.2",
    "@nuxt/schema": "^4.5.2",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "typescript-eslint": "^8.70.0",
    "unbuild": "^3.6.1",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-sfc-transformer": "^0.3.0",
    "vue-tsc": "^3.3.11",
    "typescript": "^5.4.3"
  }
}
